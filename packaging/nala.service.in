[Unit]
Description=Nala, a desktop companion
Documentation=https://github.com/yappologistic/Nala
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@NALA_BINDIR@/nala
ExecStop=@NALA_BINDIR@/nala quit
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
